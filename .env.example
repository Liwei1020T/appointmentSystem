# ========================================
# DATABASE
# ========================================
# Replace with your actual database credentials
DATABASE_URL="postgresql://username:password@localhost:5432/database_name"

# Cron job authentication secret
# Generate with: openssl rand -base64 32
CRON_SECRET="your-cron-secret-here"

# ========================================
# NEXTAUTH.JS
# ========================================
# Generate secure secrets with: openssl rand -base64 32
NEXTAUTH_SECRET="your-nextauth-secret-here"
NEXTAUTH_URL="https://your-domain.com"

AUTH_URL=https://your-domain.com
AUTH_SECRET="your-auth-secret-here"
AUTH_TRUST_HOST=true

# ========================================
# APPLICATION
# ========================================
NEXT_PUBLIC_APP_URL=https://your-domain.com
NEXT_PUBLIC_APP_NAME=String Service Platform

# ========================================
# FILE UPLOAD
# ========================================
UPLOAD_DIR="uploads"
# MAX_FILE_SIZE (MB). Set 0 to disable the size cap.
MAX_FILE_SIZE=5

# ========================================
# PAYMENT SETTINGS (TNG QR Code Manual Payment)
# ========================================
# TNG QR Code URL (本地文件或外部URL)
NEXT_PUBLIC_TNG_QR_CODE_URL=/images/tng-qr-code.png

# 支付超时时间（分钟）
PAYMENT_TIMEOUT_MINUTES=30

# ========================================
# SMS NOTIFICATIONS (Twilio)
# ========================================
SMS_PROVIDER="twilio"
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_PHONE_NUMBER="+1234567890"

# ========================================
# WEB PUSH NOTIFICATIONS
# ========================================
# Generate VAPID keys with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"

# ========================================
# OTP SECURITY
# ========================================
# Generate with: openssl rand -base64 32
OTP_SECRET="your-otp-secret-here"

# ========================================
# APP CONFIGURATION
# ========================================
REFERRAL_REWARD_POINTS=50
LOW_STOCK_THRESHOLD=5

# ========================================
# SECURITY NOTES
# ========================================
# 1. NEVER commit real credentials to version control
# 2. Generate all secrets using: openssl rand -base64 32
# 3. Use different secrets for development and production
# 4. Rotate secrets regularly in production
